# postgres
PG_USER=     # OS username
PG_PASSWORD= # required for docker compose
PG_HOST=localhost
PG_PORT=5432
PG_NAME=munchmax

GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://<PG_USER>:<PG_PASSWORD>@localhost:<PG_PORT>/munchmax?sslmode=disable
GOOSE_MIGRATION_DIR=./internal/database/migrations

# optional, will use default
PORT=   # 8080

# pipeline, not required for app
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
S3_BUCKET=

FSQ_TOKEN=
TAVILY_KEY=
NEBIUS_KEY=
